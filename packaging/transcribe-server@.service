[Unit]
Description=transcribe-server (%i)
After=network.target

[Service]
Type=exec
# Dynamic unprivileged user: models under /var/lib/transcribe/models must be
# readable by it (world-readable model files are fine).
DynamicUser=yes
NoNewPrivileges=true
ProtectSystem=strict
# GPU builds need access to the DRM/NVIDIA device nodes.
SupplementaryGroups=video render
EnvironmentFile=/etc/transcribe/%i.env
# Optional per-instance key file: keep it root-owned 0640, systemd exposes a
# copy in %d. SetCredential= is the fallback systemd uses when LoadCredential=
# finds no file - without it systemd refuses to start an instance that has no
# key file, while running with no key at all is a supported mode (auth off, as
# expected on the default 127.0.0.1 bind). The value must not be empty, or the
# whole setting is silently ignored, so it is a single newline: the key parser
# skips blank lines, hence no key is configured.
SetCredential=api-keys:\n
LoadCredential=api-keys:/etc/transcribe/%i.api-keys
# Shared prefix (linking mode 3): put the prefix lib dir on the loader path.
#Environment=LD_LIBRARY_PATH=/opt/transcribe/lib64
ExecStart=/usr/bin/transcribe-server \
    -m ${TRANSCRIBE_MODEL} \
    --host ${TRANSCRIBE_HOST} --port ${TRANSCRIBE_PORT} \
    --api-key-file %d/api-keys
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
