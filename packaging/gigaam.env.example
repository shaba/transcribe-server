# Example environment for transcribe-server@<instance>.service.
# Copy to /etc/transcribe/<instance>.env — the file name IS the instance name,
# so this one becomes /etc/transcribe/gigaam.env — edit, then:
#   systemctl enable --now transcribe-server@gigaam
#
# MODELS ARE NOT PROVIDED. GGUF models can be downloaded from
# https://huggingface.co/handy-computer into /var/lib/transcribe/models; the
# service runs as a dynamic unprivileged user, so they must be readable by it
# (world-readable model files are fine).
#
# Scalar parameters — expanded as single arguments in the unit (${...}):
TRANSCRIBE_MODEL=/var/lib/transcribe/models/gigaam-v3-e2e-rnnt-Q8_0.gguf
TRANSCRIBE_HOST=127.0.0.1
TRANSCRIBE_PORT=8010

# API keys are optional and are not configured here: the unit picks them up
# from /etc/transcribe/<instance>.api-keys (one key per line, keep it
# root-owned 0640 — systemd hands the service a copy via LoadCredential=).
# Without that file no key is configured and the server answers anonymously,
# which is what the 127.0.0.1 bind above expects.
